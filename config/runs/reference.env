# Reference configuration: the settings of the evaluation (tasks/eval/).
#
# Temperature 1, reasoning effort low, 8,192-token replies, 100 turns, the
# shared instruction, 10,000-character output truncation, llm_map, search
# hints and 80 sub-calls. Results are in README.md.
#
# env.sh loads this file. A value already set in the shell wins, so a single
# command can override one setting:
#   RLM_TEMPERATURE=0.4 bash scripts/run_reference.sh
# Every run records the settings it used under `generation` in metadata.json,
# and every batch records them in batch.json.

# --- Root model generation -------------------------------------------------
RLM_ENABLE_THINKING=1
RLM_REASONING_EFFORT=low
RLM_TEMPERATURE=1
RLM_TOP_P=0.95
RLM_TOP_K=20
RLM_MAX_TOKENS=8192

# --- Harness ----------------------------------------------------------------
# llm_map: batched delegation of semantic judgement to sub-queries.
RLM_LLM_MAP=1
# Explain an empty name search (which word matched nothing).
RLM_SEARCH_HINTS=1
# Whole-run cap on sub-queries (llm_query and llm_map batches).
SUBQ_LIMIT=80
# "The question has an answer. Do not stop until you find one." for every
# task, plus a many-steps section on multi-hop tasks.
RLM_PERSIST=1
# Replaces every task's turn limit.
RLM_TURNS=100
# Characters of a cell's output the model sees.
RLM_TRUNCATE=10000
# No stop sequence; a reply with several cells is refused instead.
RLM_STOP=0
# Task folders run by scripts/run_reference.sh.
FAMILIES=eval
# Concurrent task subprocesses. 1 runs the tasks one after another.
WORKERS=1

# --- vLLM server (scripts/serve/serve_vllm.sh) ------------------------------
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.90
KV_CACHE_DTYPE=fp8
REASONING_PARSER=qwen3
MTP_TOKENS=3
